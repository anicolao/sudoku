{
  "name": "sudoku",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync && husky",
    "dev": "vite dev --host 127.0.0.1 --port 5177 --strictPort",
    "build": "vite build",
    "build:e2e": "VITE_GIT_HASH=e2e-test-commit vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:base": "node scripts/verify-base-paths.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "UPDATE_E2E_DOCS=1 playwright test --update-snapshots --workers=1",
    "verify:change": "bash scripts/verify-change.sh"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.10.0",
    "husky": "^9.1.7",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
